{
  "$schema": "https://opencode.ai/config.json",
  // Static backstop for the .opencode/plugins/hw-guard plugin. The guard is
  // ROOM-SCOPED: its hardware rules fire only when the command's cwd is the
  // hardware worktree. A static permission glob cannot see the cwd, so the shell
  // side is plugin-only — a repo-wide shell rule would police vocabulary
  // everywhere (exactly the false positives this guard had to drop). What
  // remains here is path-based and safe repo-wide: deny read/edit of a vendor
  // path, which fires on the artifact, never on prose about it. The clean-room
  // wall itself is carried by per-role permission denies; this is a belt-and-
  // braces layer for the two path actions.
  "permissions": [
    { "action": "read", "resource": "*.recon-cache*", "effect": "deny" },
    { "action": "read", "resource": "*libOrbbecSDK*", "effect": "deny" },
    { "action": "read", "resource": "*lib_orbbec_scan*", "effect": "deny" },
    { "action": "read", "resource": "*liborbbec_scan*", "effect": "deny" },

    { "action": "edit", "resource": "*.recon-cache*", "effect": "deny" },
    { "action": "edit", "resource": "*libOrbbecSDK*", "effect": "deny" },
    { "action": "edit", "resource": "*lib_orbbec_scan*", "effect": "deny" },
    { "action": "edit", "resource": "*liborbbec_scan*", "effect": "deny" }
  ]
}
