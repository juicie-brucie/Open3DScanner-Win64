{
  "$schema": "https://opencode.ai/config.json",
  // Static backstop for the .opencode/plugins/hw-guard plugin: the same
  // invariant patterns, enforced by Core even if the plugin is disabled or
  // fails to load. Deny-only — it changes nothing else (no broad ask/allow
  // rules). The cwd-sensitive listener-test rule lives in the plugin alone,
  // because a static rule cannot see the working directory and would block a
  // legitimate in-room run.
  "permissions": [
    { "action": "shell", "resource": "*SetDllDirectory*", "effect": "deny" },
    { "action": "shell", "resource": "*AddDllDirectory*", "effect": "deny" },
    { "action": "shell", "resource": "*SetDefaultDllDirectories*", "effect": "deny" },
    { "action": "shell", "resource": "*LoadLibrary*", "effect": "deny" },
    { "action": "shell", "resource": "*DYLD_INSERT_LIBRARIES*", "effect": "deny" },
    { "action": "shell", "resource": "*LD_PRELOAD*", "effect": "deny" },
    { "action": "shell", "resource": "*.recon-cache*", "effect": "deny" },
    { "action": "shell", "resource": "*libOrbbecSDK*", "effect": "deny" },
    { "action": "shell", "resource": "*lib_orbbec_scan*", "effect": "deny" },
    { "action": "shell", "resource": "*liborbbec_scan*", "effect": "deny" },

    { "action": "read", "resource": "*.recon-cache*", "effect": "deny" },
    { "action": "read", "resource": "*libOrbbecSDK*", "effect": "deny" },
    { "action": "read", "resource": "*lib_orbbec_scan*", "effect": "deny" },
    { "action": "read", "resource": "*liborbbec_scan*", "effect": "deny" },

    { "action": "edit", "resource": "*.recon-cache*", "effect": "deny" },
    { "action": "edit", "resource": "*libOrbbecSDK*", "effect": "deny" },
    { "action": "edit", "resource": "*lib_orbbec_scan*", "effect": "deny" },
    { "action": "edit", "resource": "*liborbbec_scan*", "effect": "deny" }
  ]
}
